{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "CHL",
  "scopeName": "source.chl",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords_control" },
    { "include": "#keywords_decl" },
    { "include": "#types" },
    { "include": "#word_operators" },
    { "include": "#operators" },
    { "include": "#builtin_commands" },
    { "include": "#function_like" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.chl",
          "match": "//.*$"
        },
        {
          "name": "comment.block.chl",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.chl",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.chl",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.chl",
          "match": "\\b0x[0-9A-Fa-f]+\\b"
        },
        {
          "name": "constant.numeric.float.chl",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.chl",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "keywords_control": {
      "patterns": [
        {
          "name": "keyword.control.chl",
          "match": "\\b(if|elsif|else|end\\s+if|while|end\\s+while|begin\\s+loop|end\\s+loop|when|until|not|and|or|wait)\\b"
        }
      ]
    },
    "keywords_decl": {
      "patterns": [
        {
          "name": "keyword.other.chl",
          "match": "\\b(begin|start|end|script|camera|dialogue|cinema|known|dual|run|define|global|constant|challenge)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.chl",
          "match": "\\b(void|int|float|vec3|object|bool)\\b"
        }
      ]
    },
    "word_operators": {
      "patterns": [
        {
          "name": "keyword.operator.wordlike.chl",
          "match": "\\b(enable|disable|open|close|pause|unpause|enter|exit|forward|reverse|with|without)\\b"
        },
        {
          "name": "constant.language.chl",
          "match": "\\b(good|evil|last|home|away)\\b"
        },
        {
          "name": "keyword.other.chl",
          "match": "\\b(second|seconds)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.chl",
          "match": "(\\+=|-=|\\*=|/=|=|\\+\\+|--)"
        },
        {
          "name": "keyword.operator.comparison.chl",
          "match": "(==|!=|>=|<=|>|<)"
        },
        {
          "name": "keyword.operator.arithmetic.chl",
          "match": "(\\+|-|\\*|/|%)"
        }
      ]
    },
    "builtin_commands": {
      "patterns": [
        {
          "name": "support.function.builtin.chl",
          "match": "\\b(add|remove|move|set|delete|release|teach|force|initialise|clear|attach|detach|swap|queue|load|save|stop|restart|start|populate|disband|build|affect|toggle|snapshot|update|draw|fade|store|restore|reset|shake|eject|send|say|state|create|get|cast|make)\\b"
        }
      ]
    },
    "function_like": {
      "patterns": [
        {
          "name": "entity.name.function.chl",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.identifier.chl",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
